{
  "name": "functions",
  "private": true,
  "version": "1.0.0",
  "description": "Firebase Cloud Functions 2nd-gen backend",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "ai": "^7.0.156",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "openai": "^4.104.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
